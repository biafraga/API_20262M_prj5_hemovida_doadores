pipeline {
    agent any

    triggers {
        cron('H 2 * * *')
    }

    environment {
        IMAGE_NAME     = 'hemovida-doadores'
        CONTAINER_NAME = 'api-doadores'
        APP_PORT       = '7502'
    }

    stages {

        stage('Verificar Repositorio') {
            steps {
                checkout([$class: 'GitSCM', branches: [[name: '*/main']], useRemoteConfigs: [[url: 'https://github.com/biafraga/API_20262M_prj5_hemovida_doadores']]])
            }
        }

        stage('Instalar Dependencias') {
            steps {
                sh 'npm ci'
            }
        }

        stage('Gerar Prisma Client') {
            // o codigo importa o client gerado, entao ele precisa existir antes dos testes
            environment {
                // placeholder: o generate nao conecta no banco
                DATABASE_URL = 'mysql://USUARIO:SENHA@edumysql.acesso.rj.senac.br:3306/NOME_DO_BANCO'
            }
            steps {
                sh 'npx prisma generate'
            }
        }

        stage('Testes e2e') {
            steps {
                // sobe a API com banco de mentira e chama as rotas
                sh 'npm run test:e2e'
            }
        }

        stage('Construir Imagem Docker') {
            steps {
                sh 'docker build -t $IMAGE_NAME:$BUILD_NUMBER -t $IMAGE_NAME:latest .'
            }
        }

        stage('Fazer Deploy') {
            steps {
                // remove o container antigo; se nao existir, segue sem falhar
                sh 'docker rm -f $CONTAINER_NAME || true'

                // o token fica no cofre do Jenkins, nunca no codigo
                withCredentials([string(credentialsId: 'INFISICAL_TOKEN_BIA', variable: 'INFISICAL_TOKEN')]) {
                    sh 'docker run -d --name $CONTAINER_NAME --restart unless-stopped -p $APP_PORT:$APP_PORT -e INFISICAL_TOKEN $IMAGE_NAME:latest'
                }
            }
        }
    }

    post {
        success { echo 'Deploy realizado com sucesso!' }
        failure { echo 'Houve um erro durante o pipeline.' }
    }
}